{
  "manifest_version": 3,
  "name": "Hex Meet Participants",
  "version": "0.1.1",
  "description": "Names who speaks in Google Meet for Hex meeting transcripts.",
  "permissions": [
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "speakers.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/hex-off-16.png",
      "32": "icons/hex-off-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Hex Meet Participants"
  },
  "key": "",
  "icons": {
    "128": "icons/hex-on-128.png"
  }
}
